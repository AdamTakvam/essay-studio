# Copy to .env and fill in. The key stays on the server; the UI never asks for it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: proxy for edge-tts (defaults to HTTPS_PROXY if set)
# EDGE_TTS_PROXY=http://proxy:3128

# Optional: where projects are stored (default ./data)
# ESSAY_STUDIO_DATA=/path/to/data
